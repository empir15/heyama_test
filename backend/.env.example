# ========================================================
# HEYAMA BACKEND CONFIGURATION
# ========================================================

# Port du serveur API
PORT=3001

# Base de données MongoDB (Atlas ou Local)
# Exemple MongoDB Atlas : mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/heyama?retryWrites=true&w=majority
# Exemple MongoDB Local : mongodb://localhost:27017/heyama
MONGODB_URI=mongodb://localhost:27017/heyama

# ========================================================
# STOCKAGE S3 (Fournisseurs compatibles hors AWS)
# ========================================================

# --- OPTION 1 : Cloudflare R2 (Recommandé & Gratuit) ---
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
# S3_BUCKET_NAME=heyama-objects
# S3_PUBLIC_URL_PREFIX=https://pub-<HASH>.r2.dev
# S3_FORCE_PATH_STYLE=false

# --- OPTION 2 : Supabase Storage (S3 API) ---
# S3_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
# S3_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>
# S3_BUCKET_NAME=heyama-objects
# S3_PUBLIC_URL_PREFIX=https://<PROJECT_REF>.supabase.co/storage/v1/object/public/heyama-objects
# S3_FORCE_PATH_STYLE=true

# --- OPTION 3 : MinIO (Local ou Docker) ---
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=heyama-objects
# S3_PUBLIC_URL_PREFIX=http://localhost:9000/heyama-objects
# S3_FORCE_PATH_STYLE=true

# Configuration active par défaut (à adapter selon vos identifiants) :
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=heyama-objects
S3_PUBLIC_URL_PREFIX=
S3_FORCE_PATH_STYLE=true
